# Supabase project settings (Project Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Places API key, used client-side for place search/autocomplete.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-places-api-key

# Google Maps SDK keys, used only at native build time (app.config.ts), not
# bundled into JS. Get separate keys per platform from Google Cloud Console.
GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-api-key
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key
